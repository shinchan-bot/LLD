    {
      "id": "c-1q1JVjmEcfpMw1dhJTP",
      "type": "text",
      "x": 296.7820374735188,
      "y": -177.80717851806912,
      "width": 1146.3192138671875,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3U",
      "roundness": null,
      "seed": 1538944136,
      "version": 1238,
      "versionNonce": 948305800,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785925939498,
      "link": null,
      "locked": false,
      "text": "Requirements\n1. Upload file\n2. Download file\n3. Delete file\n4. Retrieve file metadata\n\nEntities involved\n1. StorageProvider ->Interface\n2. User -> Entity\n3. File -> Entity\n4. StorageService -> Service\n7. Subscription -> Entity\n6. FileRepository -> Entity\n\nResponsibilities\n1. StorageSErvice -> It Coordinates the complete lifecycle of upload, download, delete and metadata retrieval\n2. File -> It represents a file uploaded by a user, and contains the metadata required to manage and locate that file\n3. StorageProvider -> It is an interface to store file in external storage or filesystem\n4. Subscription -> Represents the user storage plan\n5. FileRepository -> Manages persistance and retireval of file metadata\n6. User -> Represents a user of the storage platform ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements\n1. Upload file\n2. Download file\n3. Delete file\n4. Retrieve file metadata\n\nEntities involved\n1. StorageProvider ->Interface\n2. User -> Entity\n3. File -> Entity\n4. StorageService -> Service\n7. Subscription -> Entity\n6. FileRepository -> Entity\n\nResponsibilities\n1. StorageSErvice -> It Coordinates the complete lifecycle of upload, download, delete and metadata retrieval\n2. File -> It represents a file uploaded by a user, and contains the metadata required to manage and locate that file\n3. StorageProvider -> It is an interface to store file in external storage or filesystem\n4. Subscription -> Represents the user storage plan\n5. FileRepository -> Manages persistance and retireval of file metadata\n6. User -> Represents a user of the storage platform ",
      "autoResize": true,
      "lineHeight": 1.25
    },
