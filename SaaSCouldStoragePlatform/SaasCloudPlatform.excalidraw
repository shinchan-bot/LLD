      "link": null,
      "locked": false,
      "text": "file upload-> user calls upload with filename and userid -> storage service calls subscription to check valid -> storage service calls file to store file info -> storage service calls storage provider to select any one storage provider -> storage service calls storage provider to upload file by passing info using file object -> storage service saves file object into file repository",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "file upload-> user calls upload with filename and userid -> storage service calls subscription to check valid -> storage service calls file to store file info -> storage service calls storage provider to select any one storage provider -> storage service calls storage provider to upload file by passing info using file object -> storage service saves file object into file repository",
      "autoResize": true,
      "lineHeight": 1.25
    },
